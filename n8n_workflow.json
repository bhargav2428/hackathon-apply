          "conditions": [
            {
              "id": "has-deadlines",
              "leftValue": "={{ $json.deadlines.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-urgent-deadlines",
      "name": "If Urgent Deadlines",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 700]
