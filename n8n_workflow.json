            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-auto-apply",
              "leftValue": "={{$env.AUTO_APPLY_ENABLED}}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-auto-apply",
      "name": "If Auto Apply Enabled",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
