      "id": "get-weekly-stats",
      "name": "Get Weekly Stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 900],
      "credentials": {
        "httpHeaderAuth": {
          "id": "api-auth",
          "name": "API Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Create weekly summary\nconst stats = $input.item.json;\n\nconst message = `📊 Weekly Summary\\n\\n` +\n  `Total Hackathons: ${stats.hackathons?.total || 0}\\n` +\n  `Upcoming: ${stats.hackathons?.upcoming || 0}\\n` +\n  `Applications: ${stats.applications?.total || 0}\\n` +\n  `  - Pending: ${stats.applications?.pending || 0}\\n` +\n  `  - Submitted: ${stats.applications?.submitted || 0}\\n` +\n  `  - Accepted: ${stats.applications?.accepted || 0}\\n` +\n  `AI Ideas Generated: ${stats.ai_ideas || 0}\\n` +\n  `Profile Completeness: ${stats.profile_completeness || 0}%`;\n\nreturn {\n  json: {\n    message: message\n  }\n};"
      },
      "id": "format-weekly-summary",
      "name": "Format Weekly Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 900]
    },
