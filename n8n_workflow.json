{
  "name": "AI Hackathon Auto Apply Agent",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "notes": "Runs every 6 hours to check for new hackathons"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_URL}}/api/hackathons/scrape",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "scrape-hackathons",
      "name": "Scrape Hackathons",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "api-auth",
          "name": "API Auth"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-1",
              "leftValue": "={{ $json.results.new }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-new-hackathons",
      "name": "If New Hackathons",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.API_URL}}/api/hackathons?status=upcoming&limit=20",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "get-upcoming-hackathons",
      "name": "Get Upcoming Hackathons",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "api-auth",
          "name": "API Auth"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Filter hackathons based on criteria\nconst hackathon = $input.item.json;\nconst now = new Date();\nconst deadline = new Date(hackathon.registration_deadline);\nconst daysUntilDeadline = Math.ceil((deadline - now) / (1000 * 60 * 60 * 24));\n\n// Only process if:\n// 1. Registration is still open\n// 2. Deadline is within 14 days\n// 3. It's not already applied to\nif (hackathon.is_registration_open && daysUntilDeadline > 0 && daysUntilDeadline <= 14) {\n  return {\n    json: {\n      ...hackathon,\n      days_until_deadline: daysUntilDeadline\n    }\n  };\n}\n\nreturn null;"
      },
      "id": "filter-eligible",
      "name": "Filter Eligible Hackathons",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_URL}}/api/ai/eligibility/{{ $json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "check-eligibility",
      "name": "Check Eligibility",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "api-auth",
          "name": "API Auth"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-eligible",
              "leftValue": "={{ $json.is_eligible }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            },
            {
              "id": "condition-score",
              "leftValue": "={{ $json.score }}",
              "rightValue": 0.6,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-eligible",
      "name": "If Eligible",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1560, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_URL}}/api/applications",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ hackathon_id: $json.hackathon_id }) }}",
        "options": {}
      },
      "id": "create-application",
      "name": "Create Application",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 100],
      "credentials": {
        "httpHeaderAuth": {
          "id": "api-auth",
          "name": "API Auth"
        }
