    {
      "parameters": {
        "jsCode": "// Create deadline reminder message\nconst deadlines = $input.item.json.deadlines;\nlet message = 'Upcoming deadlines:\\n\\n';\n\nfor (const d of deadlines) {\n  message += `🔔 ${d.hackathon.name}\\n`;\n  message += `   Deadline: ${new Date(d.hackathon.registration_deadline).toLocaleDateString()}\\n`;\n  message += `   Days left: ${d.days_left}\\n\\n`;\n}\n\nreturn {\n  json: {\n    message: message,\n    count: deadlines.length\n  }\n};"
      },
      "id": "format-deadlines",
      "name": "Format Deadline Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 600]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_URL}}/api/notifications",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: 'deadline_reminder', title: 'Urgent: ' + $json.count + ' Deadline(s) Approaching', message: $json.message }) }}",
        "options": {}
      },
      "id": "send-deadline-reminder",
      "name": "Send Deadline Reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 600],
      "credentials": {
        "httpHeaderAuth": {
