        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: 'system', title: 'Weekly Activity Summary', message: $json.message }) }}",
        "options": {}
